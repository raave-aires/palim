generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Model para os dados dos alunos
model Aluno {
  matricula   String       @id
  aluno       String
  turma       String
  turno       String
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  ocorrencias Ocorrencia[]
}

// Model para os dados dos funcionários da escola
model Servidores {
  matricula   String       @id @unique
  nome        String
  cargo       String? // Adicionei um campo opcional para o cargo (Professor, Coordenador, etc.)
  ativo       Boolean      @default(true) // Campo para indicar se está trabalhando ativamente
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  // Relações
  user        User?        // Um servidor pode ter uma conta de usuário (relação 1 para 1)
  ocorrencias Ocorrencia[] // Um servidor pode criar várias ocorrências
}

// Model para as ocorrências, agora com referência a quem a criou
model Ocorrencia {
  codigo    String   @id
  situacao  String   @default("Registrada")
  data      DateTime @db.Timestamptz(3)
  medida    String
  descricao String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  // Relação com Aluno (quem sofreu a ocorrência)
  alunoId   String
  aluno     Aluno    @relation(fields: [alunoId], references: [matricula], onDelete: Cascade)

  // Relação com Servidores (quem registrou a ocorrência)
  criadoPorMatricula String
  criadoPor          Servidores @relation(fields: [criadoPorMatricula], references: [matricula])

  @@index([alunoId])
  @@index([criadoPorMatricula])
}

// --- MODELS DE AUTENTICAÇÃO ---
// Model de usuário para autenticação, agora ligado a um Servidor
model User {
  id            String    @id
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @db.Timestamptz(3)
  updatedAt     DateTime  @db.Timestamptz(3)

  // Relação com Servidores. A conta de usuário pertence a um servidor.
  servidorMatricula String     @unique // Garante que um servidor só pode ter uma conta
  servidor          Servidores @relation(fields: [servidorMatricula], references: [matricula], onDelete: Cascade)

  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                  String    @id
  accountId           String
  providerId          String
  userId              String
  accessToken         String?
  refreshToken        String?
  idToken             String?
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope               String?
  password            String?
  createdAt           DateTime  @db.Timestamptz(3)
  updatedAt           DateTime  @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime? @db.Timestamptz(3)
  updatedAt  DateTime? @db.Timestamptz(3)

  @@map("verification")
}